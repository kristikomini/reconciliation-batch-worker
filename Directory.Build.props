<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NOT InvariantGlobalization: Microsoft.Data.SqlClient requires ICU/globalization. Parsing
         and formatting pin CultureInfo.InvariantCulture explicitly where determinism matters. -->
  </PropertyGroup>
</Project>
